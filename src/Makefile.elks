# Lua 5.1 Makefile for ELKS, compiled using OpenWatcom C
# make -f Makefile.elks
#
# Default build:
#   Lua + gfx API + VGA Mode X backend
#
# Nano-X build:
#   make -f Makefile.elks USE_NANOX_BACKEND=1 \
#       NANOX_DIR=/root/microwindows/src
#
# Optimization selection:
#   make -f Makefile.elks OPT=size
#   make -f Makefile.elks OPT=speed
#   make -f Makefile.elks OPT=none

ifndef TOPDIR
$(error ELKS TOPDIR is not defined)
endif

ifndef WATCOM
$(error OpenWatcom WATCOM is not defined)
endif

CC = owcc
LD = owcc

CLBASE = -mcmodel=l
CLBASE += -bnone -march=i86 -std=c99
CLBASE += -fno-stack-check -fnostdlib -fsigned-char
CLBASE += -Wc,-fpc -Wc,-zev -Wc,-zls -Wc,-x -Wc,-wcd=303

WARNINGS = -Wall -Wextra

INCLUDES = -I.
INCLUDES += -I$(TOPDIR)/libc/include -I$(TOPDIR)/elks/include
INCLUDES += -I$(TOPDIR)/libc/include/watcom

DEFINES = -D__ELKS__ -DLUA_ANSI

# ------------------------------------------------------------
# Optimization selection
#
# Default:
#   OPT=speed
#
# Size build:
#   make -f Makefile.elks OPT=size
#
# Speed build:
#   make -f Makefile.elks OPT=speed
#
# No optimization / easier debugging:
#   make -f Makefile.elks OPT=none
# ------------------------------------------------------------

OPT ?= speed

ifeq ($(OPT),size)
OPTFLAGS = -Os
endif

ifeq ($(OPT),speed)
OPTFLAGS = -Wc,-oneatx
endif

ifeq ($(OPT),none)
OPTFLAGS =
endif

ifeq ($(filter $(OPT),size speed none),)
$(error Unknown OPT '$(OPT)'. Use OPT=size, OPT=speed, or OPT=none)
endif

# ------------------------------------------------------------
# Graphics backend selection
#
# Common graphics and input objects:
#   graphics.c
#   keyboard.c
#
# Common font and text objects:
#   font.c
#   font_builtin_8x8.c
#   rendtext.c
#
# Default:
#   USE_NANOX_BACKEND=0
#   graphics.c uses VGA Mode X through vgax.c/vgax.h
#   keyboard.c uses nonblocking console input
#   text is rendered through the Mode X horizontal-line backend
#
# Nano-X:
#   USE_NANOX_BACKEND=1
#   graphics.c uses nanox.c/nanox.h
#   keyboard.c builds its Nano-X keyboard stub
#   text is rendered through the Nano-X horizontal-line backend
#   vgax.c is not linked
# ------------------------------------------------------------

USE_NANOX_BACKEND ?= 0
NANOX_DIR ?= /root/toncho11_microwindows/src

GFX_OBJS = graphics.obj keyboard.obj os.obj \
	font.obj font_builtin_8x8.obj rendtext.obj
NANOX_CLIENT_OBJS =

ifeq ($(USE_NANOX_BACKEND),1)

DEFINES += -DUSE_NANOX_BACKEND
DEFINES += -DELKS=1 -DUNIX=1 -DNONETWORK=0
DEFINES += -DMWPIXEL_FORMAT=MWPF_PALETTE
DEFINES += -DSCREEN_PIXTYPE=MWPF_PALETTE

INCLUDES += -I$(NANOX_DIR)/include
INCLUDES += -I$(NANOX_DIR)/nanox
INCLUDES += -I$(NANOX_DIR)/drivers

GFX_OBJS += nanox.obj

NANOX_CLIENT_OBJS = nx_client.obj nx_nxproto.obj nx_nxutil.obj nx_osdep.obj

else

# Default fullscreen VGA Mode X backend
GFX_OBJS += vgax.obj

endif

LOCALFLAGS = -DNDEBUG

CFLAGS = $(OPTFLAGS) $(CLBASE) $(WARNINGS) $(INCLUDES) \
	$(DEFINES) $(LOCALFLAGS)

LDBASE = -bos2 -s
LDBASE += -Wl,option -Wl,dosseg
LDBASE += -Wl,option -Wl,start=_start
LDBASE += -Wl,option -Wl,nodefaultlibs
LDBASE += -Wl,option -Wl,stack=0x2000
LDBASE += -Wl,option -Wl,heapsize=512

LDFLAGS = $(LDBASE)
LDLIBS = -Wl,library -Wl,$(TOPDIR)/libc/libcl.lib

BINDIR = ../elks-bin
PROG = lua luac

SRCS = mem.c lmathlib.c lapi.c lcode.c ldebug.c ldo.c ldump.c \
	lfunc.c lgc.c llex.c lmem.c lobject.c lopcodes.c lparser.c \
	lstate.c lstring.c ltable.c ltm.c lundump.c lvm.c lzio.c \
	lauxlib.c lbaselib.c ldblib.c liolib.c loslib.c ltablib.c \
	lstrlib.c loadlib.c linit.c

OBJS = $(SRCS:.c=.obj) $(GFX_OBJS) $(NANOX_CLIENT_OBJS)

all: $(PROG)

elks: all

lua: $(OBJS) lua.obj
	$(LD) $(LDFLAGS) -o $@ $(OBJS) lua.obj $(LDLIBS)

luac: $(OBJS) luac.obj print.obj
	$(LD) $(LDFLAGS) -o $@ $(OBJS) luac.obj print.obj $(LDLIBS)

%.obj: %.c
	$(CC) -c $(CFLAGS) -o $*.obj $<

lua.obj: lua.c
	$(CC) -c $(CFLAGS) -o lua.obj $<

luac.obj: luac.c
	$(CC) -c $(CFLAGS) -o luac.obj $<

print.obj: print.c
	$(CC) -c $(CFLAGS) -o print.obj $<

# ------------------------------------------------------------
# Lua base library
#
# lbaselib.c directly includes graphics.h, keyboard.h and font.h.
# Keep these dependencies explicit so changes to the graphics,
# keyboard or public font constants rebuild lbaselib.obj.
# ------------------------------------------------------------

lbaselib.obj: lbaselib.c graphics.h keyboard.h font.h
	$(CC) -c $(CFLAGS) -o lbaselib.obj lbaselib.c

# ------------------------------------------------------------
# Common graphics, keyboard, font and text files
# ------------------------------------------------------------

graphics.obj: graphics.c graphics.h font.h rendtext.h os.h
	$(CC) -c $(CFLAGS) -o graphics.obj graphics.c

keyboard.obj: keyboard.c keyboard.h
	$(CC) -c $(CFLAGS) -o keyboard.obj keyboard.c
	
os.obj: os.c os.h
	$(CC) -c $(CFLAGS) -o os.obj os.c

font.obj: font.c font.h
	$(CC) -c $(CFLAGS) -o font.obj font.c

font_builtin_8x8.obj: font_builtin_8x8.c font.h
	$(CC) -c $(CFLAGS) -o font_builtin_8x8.obj font_builtin_8x8.c

rendtext.obj: rendtext.c rendtext.h font.h
	$(CC) -c $(CFLAGS) -o rendtext.obj rendtext.c

# ------------------------------------------------------------
# Graphics backend files
# ------------------------------------------------------------

vgax.obj: vgax.c vgax.h
	$(CC) -c $(CFLAGS) -o vgax.obj vgax.c

nanox.obj: nanox.c nanox.h graphics.h
	$(CC) -c $(CFLAGS) -o nanox.obj nanox.c

# ------------------------------------------------------------
# Nano-X client objects
# ------------------------------------------------------------

nx_client.obj: $(NANOX_DIR)/nanox/client.c
	$(CC) -c $(CFLAGS) -o $@ $<

nx_nxproto.obj: $(NANOX_DIR)/nanox/nxproto.c
	$(CC) -c $(CFLAGS) -o $@ $<

nx_nxutil.obj: $(NANOX_DIR)/nanox/nxutil.c
	$(CC) -c $(CFLAGS) -o $@ $<

nx_osdep.obj: $(NANOX_DIR)/drivers/osdep.c
	$(CC) -c $(CFLAGS) -o $@ $<

clean:
	rm -f $(PROG) *.obj tmp.h
